{
  "name": "junxiong-notes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "node scripts/check-links.mjs && node scripts/render-diagrams.mjs && node scripts/generate-agent-files.mjs",
    "dev": "node scripts/render-diagrams.mjs && node scripts/generate-agent-files.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "links": "node scripts/check-links.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "logos": "node scripts/fetch-logos.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm test && npm run links && npm run lint"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "next": "^16.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "uipack": "https://github.com/ong6/uipack/releases/download/v0.4.0/uipack-0.4.0.tgz",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@terrastruct/d2": "^0.1.33",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.13",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
